{
  "name": "ai-bookmark-manager",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Local-first bookmark workspace with approved native organization, backups and MiniMax multi-turn reference search.",
  "scripts": {
    "postinstall": "wxt prepare",
    "dev": "wxt prepare && wxt",
    "dev:clean": "wxt clean && wxt prepare && wxt",
    "open:chrome-ext": "osascript -e 'tell application \"Google Chrome\" to open location \"chrome://extensions\"' -e 'tell application \"Google Chrome\" to activate'",
    "open:devdir": "open .output/chrome-mv3-dev",
    "build": "wxt prepare && wxt build",
    "zip": "wxt prepare && wxt zip",
    "typecheck": "wxt prepare && vue-tsc --noEmit -p tsconfig.json",
    "test": "wxt prepare && vitest run",
    "lint": "eslint . --ext .ts,.vue",
    "lint:fix": "eslint . --ext .ts,.vue --fix",
    "test:browser": "node tests/e2e/browser-smoke.mjs"
  },
  "dependencies": {
    "@element-plus/icons-vue": "^2.3.1",
    "dexie": "^4.0.11",
    "element-plus": "^2.9.5",
    "htmlparser2": "^12.0.0",
    "pinia": "^3.0.1",
    "vue": "^3.5.13"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/chrome": "^0.0.300",
    "@typescript-eslint/eslint-plugin": "^8.71.2",
    "@typescript-eslint/parser": "^8.71.2",
    "@vitejs/plugin-vue": "^5.2.1",
    "eslint": "^10.12.0",
    "eslint-plugin-vue": "^10.11.1",
    "fake-indexeddb": "^6.2.5",
    "happy-dom": "^15.11.7",
    "playwright": "^1.62.1",
    "typescript": "^5.8.2",
    "vite": "^6.2.1",
    "vitest": "^3.0.8",
    "vue-eslint-parser": "^10.4.1",
    "vue-tsc": "^2.2.8",
    "wxt": "^0.20.0"
  }
}
